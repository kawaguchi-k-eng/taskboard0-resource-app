# --- Trust configuration for incoming ID-JAGs ---
# The customer's Okta org's issuer AS CONFIGURED FOR SIGN-IN, e.g.
# https://your-org.okta.com/oauth2/default (a custom authorization server
# is normal and correct here). This app derives the ORG authorization
# server's root from it (strips the /oauth2/default path) because ID-JAGs
# are only ever minted and signed by the org AS, never a custom one.
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
# Optional overrides, only needed if the derived org-root guess is wrong:
# OKTA_ORG_ISSUER=https://your-org.okta.com
# OKTA_JWKS_URI=https://your-org.okta.com/oauth2/v1/keys

# This app's own resource identifier. Must exactly match:
# - the "Audience/tenant ID" you set in Okta's Cross App Access (XAA)
#   config for this app (Applications > Taskboard0 > Machine Assignments >
#   Callers > Cross App Access (XAA))
# - the `resource` value the requesting app (linear-xaa-agent) sends
RESOURCE_AUDIENCE=https://your-deployed-taskboard0-url

# Comma-separated client_id(s) this resource app accepts ID-JAGs for — the
# value(s) you entered as "External client ID" when creating the XAA
# resource connection for the requesting app in Okta.
TRUSTED_REQUESTING_APP_CLIENT_IDS=

# Symmetric secret this server uses to sign/verify its own access tokens.
# Generate with: openssl rand -base64 32
ACCESS_TOKEN_SIGNING_SECRET=

# Uncomment to log each ID-JAG's decoded claims to stdout — useful the
# first time you wire up a new Okta org, to see exactly what it put in the
# `client_id`/`cid` claim before deciding TRUSTED_REQUESTING_APP_CLIENT_IDS.
# DEBUG_LOG_ID_JAG_CLAIMS=true
